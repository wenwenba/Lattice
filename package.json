{
  "name": "lattice-tui",
  "version": "0.1.1",
  "description": "A keyboard-first, Obsidian-inspired Markdown knowledge base for the terminal.",
  "type": "module",
  "license": "MIT",
  "author": "WENWENBABA",
  "homepage": "https://lattice-tui.chnova-6234.chatgpt.site",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wenwenba/Lattice.git"
  },
  "bugs": {
    "url": "https://github.com/wenwenba/Lattice/issues"
  },
  "keywords": [
    "markdown",
    "terminal",
    "tui",
    "notes",
    "knowledge-base",
    "vue"
  ],
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "lattice": "dist/main.mjs"
  },
  "scripts": {
    "dev": "vite",
    "site:dev": "vite --config website/vite.config.ts",
    "site:build": "vite build --config website/vite.config.ts",
    "type-check": "vue-tsc --build",
    "test": "vitest run --config vitest.config.ts",
    "build": "vite build && node scripts/make-executable.mjs",
    "check": "pnpm type-check && pnpm test && pnpm build",
    "prepublishOnly": "pnpm check",
    "start": "node dist/main.mjs"
  },
  "dependencies": {
    "@vue-tui/runtime": "0.3.0",
    "string-width": "8.2.2",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@simon_he/vue-tui": "1.1.6",
    "@tsconfig/node22": "^22.0.5",
    "@types/node": "^22.18.0",
    "@vue-tui/testing": "0.3.0",
    "@vue-tui/vite": "0.3.1",
    "@vue/tsconfig": "^0.9.1",
    "typescript": "~6.0.0",
    "unplugin-vue": "7.2.0",
    "vite": "8.2.1",
    "vitest": "^4.0.0",
    "vue-tsc": "3.3.4"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@11.23.0"
}
